{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/puppeteer-extra-plugin-stealth/evasions/**/*",
          "node_modules/puppeteer-extra-plugin-user-preferences/**/*"
        ],
        "maxDuration": 800
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 4 * * *"
    }
  ]
}
