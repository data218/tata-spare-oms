{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "server.js": {
      "maxDuration": 800,
      "includeFiles": [
        "node_modules/puppeteer-extra-plugin-*/**/*",
        "node_modules/fs-extra/**/*",
        "node_modules/rimraf/**/*",
        "node_modules/deepmerge/**/*"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 4 * * *"
    }
  ]
}
