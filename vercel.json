{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
  ],
  "functions": {
    "server.js": {
      "includeFiles": "node_modules/puppeteer-extra-plugin-stealth/evasions/**/*.js"
    }
  }
}
