# Copy to `.env` on the machine that runs the bot (local-worker.mjs) and the
# server. NEVER commit the real `.env` and NEVER expose these values to the
# browser bundle.

# --- Supabase (server / bot only) -------------------------------------------
# Recommended: use the service-role key so the bot no longer relies on the
# public anon key. Service-role bypasses RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Tata BI portal (consumption scraper) -----------------------------------
# Kept out of the database so the password is not readable with the anon key.
TATA_BI_USERNAME=your_tata_bi_username
TATA_BI_PASSWORD=

# --- Per-location Siebel credentials (inventory scraper) --------------------
# Alternatively, use Settings > Dealership Locations > Test & Save after
# updating the worker. New passwords are encrypted for that worker. Run
# npm.cmd run worker:access locally to obtain its private setup code.
# JSON array. Only `location_name` needs to exist in the public tata_locations
# table for the dashboard dropdowns; username/password stay server-side here.
TATA_LOCATIONS_JSON=[{"location_name":"NARWAL","username":"","password":""},{"location_name":"CHANNIRAMA","username":"","password":""}]
