+    const now = new Date();
+    const parts = window.originalProcessedParts || [];
+
+    parts.forEach(p => {
+      const receiptStr = p.last_receipt || p.fetched_at;
+      if (!receiptStr) return;
+      const receiptDate = new Date(receiptStr);
+      if (isNaN(receiptDate)) return;
+      const msDiff = now - receiptDate;
+      const daysDiff = msDiff / (1000 * 60 * 60 * 24);
+      let bucket = 3;
+      if (daysDiff <= 30) bucket = 0;
+      else if (daysDiff <= 60) bucket = 1;
+      else if (daysDiff <= 90) bucket = 2;
+      else bucket = 3;
+      agingQty[bucket] += Number(p.currentStock) || 0;
+      agingVal[bucket] += Number(p.stockValue) || 0;
+    });
+
+    const updateAgeing = (id, val) => {
